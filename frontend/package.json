{
  "name": "sportify-club-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "lint": "eslint . --report-unused-disable-directives",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "security:audit": "npm audit --omit=dev",
    "ms1": "npm --prefix ../backend/microservice run start:ms1",
    "ms2": "npm --prefix ../backend/microservice run start:ms2",
    "microservices": "npm --prefix ../backend/microservice run start:all"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.6",
    "axios": "^1.7.9",
    "lucide-react": "^1.46.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.92.0",
    "react-hot-toast": "^2.6.1",
    "react-router-dom": "^7.0.2",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^5.1.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.4.5",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    }
  }
}
