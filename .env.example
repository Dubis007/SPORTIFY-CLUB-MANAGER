# Copiar a .env (jamás se sube al repositorio) y definir valores reales localmente
MYSQL_ROOT_PASSWORD=cambia_esta_clave_segura
SPORTIFY_MYSQL_CONNECTION="Server=localhost;Port=3306;Database=sportify_db;Uid=root;Pwd=cambia_esta_clave_segura;"

# Secretos de la API y del microservicio 1. Deben ser propios y tener 32 caracteres o más.
# Con los valores de ejemplo de abajo los contenedores NO arrancan: el código no trae llaves por defecto.
# Genera cada uno con:  openssl rand -base64 48
# JWT_SECRET firma las sesiones; SPORTIFY_AES_MASTER_KEY cifra datos sensibles (no la cambies con datos ya guardados).
JWT_SECRET=cambia_este_secreto_de_al_menos_32_caracteres
SPORTIFY_AES_MASTER_KEY=cambia_esta_llave_maestra_aes_256_de_32_bytes

# Puertos que Docker Compose publica en tu equipo. Cambia el que esté ocupado y vuelve a levantar.
# DB_PORT=3308 evita chocar con XAMPP (3306) o con otro MySQL local (3307).
DB_PORT=3308
API_PORT=8080
WEB_PORT=8081
MS1_PORT=5101
MS2_PORT=5102
